<Window x:Class="DolgozatokWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dolgozatok" Height="540" Width="780"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="dgDolgozatok" Grid.Row="0" AutoGenerateColumns="True" FontSize="16" Margin="10"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20">
            <Label Content="Név:" FontSize="16" VerticalAlignment="Center"/>
            <TextBox x:Name="txtNev" Width="240" Height="40" FontSize="16" Margin="10"/>

            <Label Content="Életkor:" FontSize="16" VerticalAlignment="Center"/>
            <TextBox x:Name="txtEletkor" Width="80" Height="40" FontSize="16" Margin="10"/>

            <Label Content="Pontszám:" FontSize="16" VerticalAlignment="Center"/>
            <TextBox x:Name="txtPontszam" Width="80" Height="40" FontSize="16" Margin="10"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button x:Name="btnHozzaadas" Content="Hozzáadás" Width="160" FontSize="16" Margin="10" Click="btnHozzaadas_Click"/>
            <Button x:Name="btnMentes" Content="Mentés" Width="160" Height="50" FontSize="16" Margin="10" Click="btnMentes_Click"/>
        </StackPanel>
    </Grid>
</Window>